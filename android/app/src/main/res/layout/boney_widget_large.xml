<?xml version="1.0" encoding="utf-8"?>
<!-- Boney, large (4x4): check-ins and status, Boney with the countdown, up to three tiers, action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/boney_bg_alive"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/boney_count_row"
            android:importantForAccessibility="yes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/boney_heart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/boney_px_heart" />

            <TextView
                android:id="@+id/boney_count"
                android:importantForAccessibility="no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/outfit_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/boney_bone"
                android:textSize="22sp" />

            <!-- Check-ins recorded on chain, not a streak. -->
            <TextView
                android:id="@+id/boney_count_label"
                android:importantForAccessibility="no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/outfit_regular"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/boney_count_label"
                android:textColor="@color/boney_sub"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/boney_sticker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/boney_pill_void"
            android:fontFamily="@font/jetbrains_mono_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="@string/boney_sticker_alive"
            android:textColor="@color/boney_pulse"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.45">

            <ImageView
                android:id="@+id/boney_image"
                android:contentDescription="@string/boney_widget_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:scaleType="fitXY"
                android:src="@drawable/boney_px_on_track" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="0.55"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/boney_title_box"
                android:layout_width="match_parent"
                android:layout_height="48dp">

                <TextView
                    android:id="@+id/boney_title"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autoSizeMaxTextSize="36sp"
                    android:autoSizeMinTextSize="18sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/jetbrains_mono_medium"
                    android:gravity="start|center_vertical"
                    android:maxLines="1"
                    android:textColor="@color/boney_pulse"
                    android:textSize="34sp" />

                <Chronometer
                    android:id="@+id/boney_chrono"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autoSizeMaxTextSize="36sp"
                    android:autoSizeMinTextSize="18sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/jetbrains_mono_medium"
                    android:gravity="start|center_vertical"
                    android:maxLines="1"
                    android:textColor="@color/boney_pulse"
                    android:textSize="34sp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/boney_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_regular"
                android:maxLines="3"
                android:textColor="@color/boney_sub"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/boney_tier_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/boney_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/boney_tier_label_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_regular"
                android:maxLines="1"
                android:textColor="@color/boney_bone"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/boney_tier_value_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/jetbrains_mono_medium"
                android:maxLines="1"
                android:textColor="@color/boney_ash"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/boney_tier_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/boney_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/boney_tier_label_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_regular"
                android:maxLines="1"
                android:textColor="@color/boney_bone"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/boney_tier_value_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/jetbrains_mono_medium"
                android:maxLines="1"
                android:textColor="@color/boney_ash"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/boney_tier_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/boney_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/boney_tier_label_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_regular"
                android:maxLines="1"
                android:textColor="@color/boney_bone"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/boney_tier_value_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/jetbrains_mono_medium"
                android:maxLines="1"
                android:textColor="@color/boney_ash"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/boney_button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/boney_button_pulse"
        android:ellipsize="end"
        android:fontFamily="@font/outfit_semibold"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/boney_button_open_app"
        android:textColor="@color/boney_void"
        android:textSize="16sp" />
</LinearLayout>
