<?xml version="1.0" encoding="utf-8"?>
<!-- Boney, small (2x2): check-ins, a one-line mood and Boney. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/boney_bg_alive"
    android:clipToOutline="true"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/boney_count_row"
            android:importantForAccessibility="yes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/boney_heart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/boney_px_heart" />

            <TextView
                android:id="@+id/boney_count"
                android:importantForAccessibility="no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/outfit_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/boney_bone"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/boney_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_regular"
            android:maxLines="1"
            android:text="@string/boney_button_open_app"
            android:textColor="@color/boney_bone_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/boney_image"
        android:contentDescription="@string/boney_widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:scaleType="fitXY"
        android:src="@drawable/boney_px_on_track" />
</FrameLayout>
