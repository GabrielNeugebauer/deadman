<?xml version="1.0" encoding="utf-8"?>
<!--
  One responsive provider: Android 12+ gets a RemoteViews per reported size
  (small 2x2, medium 4x2, large 4x4) and swaps them on resize without waking
  the app. The app pushes every update (home_widget), so updatePeriodMillis is 0;
  BoneyWidgetProvider arms its own non-wakeup alarms for time-based changes.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/boney_widget_description"
    android:initialLayout="@layout/boney_widget_small"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewImage="@drawable/boney_widget_preview"
    android:previewLayout="@layout/boney_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
